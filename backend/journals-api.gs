/* JSON journals. No Sheets dependency. Deploy as owner; files remain private. */
function jsonReply_(value){return ContentService.createTextOutput(JSON.stringify(value)).setMimeType(ContentService.MimeType.JSON)}
function props_(){return PropertiesService.getScriptProperties()}
function hash_(s){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(s),Utilities.Charset.UTF_8).map(b=>('0'+(b&255).toString(16)).slice(-2)).join('')}
function uuid_(s){return typeof s==='string'&&/^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$/i.test(s)}
function checkId_(id){if(!uuid_(id))throw Error('Cod UUID invalid.')}
function folder_(){const p=props_(),id=p.getProperty('LANE_JSON_FOLDER');if(!id)throw Error('Serviciul de jurnale nu este încă activat.');return DriveApp.getFolderById(id)}
function loadFile_(fileId){return JSON.parse(DriveApp.getFileById(fileId).getBlob().getDataAsString('UTF-8'))}
function saveFile_(fileId,j){DriveApp.getFileById(fileId).setContent(JSON.stringify(j))}
function journal_(id){checkId_(id);const fid=props_().getProperty('J_'+hash_(id));if(!fid)throw Error('Codul jurnalului nu este corect.');return {fid:fid,j:loadFile_(fid)}}
function snapshot_(j){return {ok:true,schema:3,revision:j.revision,slug:j.slug,data:j.data}}
function slug_(name){return name.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,'_').replace(/^_|_$/g,'')||'inotator'}
function limitCreate_(){const c=CacheService.getScriptCache(),key='lane_create_minute_'+Math.floor(Date.now()/60000),n=Number(c.get(key)||0);if(n>=10)throw Error('Prea multe înregistrări. Încearcă din nou peste un minut.');c.put(key,String(n+1),120)}
function createJournal_(q,migration){checkId_(q.id);checkId_(q.recovery);const p=props_(),existing=p.getProperty('J_'+hash_(q.id));if(existing)return snapshot_(loadFile_(existing));const data=LaneModel.normalize(q.data);if(data.demo)throw Error('Datele demo nu pot fi înregistrate.');if(!migration&&(data.results.length||data.meets.length))throw Error('Un jurnal nou trebuie să fie gol.');limitCreate_();const serial=Number(p.getProperty('LANE_JSON_SERIAL')||0)+1;const j={schema:3,revision:1,slug:slug_(data.name)+'_'+serial,accessHashes:[hash_(q.id)],recoveryHash:hash_(q.recovery),nameKey:data.name.trim().toLowerCase(),createdAt:new Date().toISOString(),data:data};const f=folder_().createFile('journal_'+Utilities.getUuid()+'.json',JSON.stringify(j),'application/json');p.setProperty('J_'+hash_(q.id),f.getId());p.setProperty('R_'+hash_(q.recovery),f.getId());p.setProperty('LANE_JSON_SERIAL',String(serial));if(migration)p.setProperty('LANE_MIGRATED_JSON',f.getId());return snapshot_(j)}
function doGet(){return jsonReply_({ok:true,schema:3,service:'LANE JSON journals'})}
function doPost(e){const lock=LockService.getScriptLock();try{if(!e||!e.postData||e.postData.contents.length>2000000)throw Error('Cerere invalidă sau prea mare.');const q=JSON.parse(e.postData.contents);lock.waitLock(20000);if(q.action==='create')return jsonReply_(createJournal_(q,false));if(q.action==='migrate'){if(!q.legacyToken||hash_(q.legacyToken)!==hash_(props_().getProperty('LANE_TOKEN')||'missing'))throw Error('Migrare neautorizată.');const fid=props_().getProperty('LANE_MIGRATED_JSON');if(fid){const own=props_().getProperty('J_'+hash_(q.id));if(own===fid)return jsonReply_(snapshot_(loadFile_(fid)));throw Error('Jurnalul a fost deja migrat. Folosește UUID-ul sau codul de recuperare.')}return jsonReply_(createJournal_(q,true))}if(q.action==='recover'){checkId_(q.recovery);checkId_(q.newId);const fid=props_().getProperty('R_'+hash_(q.recovery));if(!fid)throw Error('Numele sau codul de recuperare nu este corect.');const j=loadFile_(fid);if(String(q.name||'').trim().toLowerCase()!==j.data.name.trim().toLowerCase())throw Error('Numele sau codul de recuperare nu este corect.');const newHash=hash_(q.newId);props_().setProperty('J_'+newHash,fid);(j.accessHashes||[]).forEach(h=>{if(h!==newHash)props_().deleteProperty('J_'+h)});j.accessHashes=[newHash];saveFile_(fid,j);return jsonReply_(snapshot_(j))}const found=journal_(q.id),j=found.j;if(q.action==='read')return jsonReply_(snapshot_(j));if(q.action==='write'){if(q.revision!==j.revision)return jsonReply_({ok:false,code:'CONFLICT',error:'Jurnalul s-a schimbat pe alt dispozitiv.',current:snapshot_(j)});const next=LaneModel.normalize(q.data);if(next.demo)throw Error('Datele demo nu pot fi salvate.');j.data=next;j.revision++;j.updatedAt=new Date().toISOString();saveFile_(found.fid,j);return jsonReply_(snapshot_(j))}throw Error('Operație necunoscută.')}catch(err){return jsonReply_({ok:false,error:err.message})}finally{if(lock.hasLock())lock.releaseLock()}}
/** Run once as owner; Google asks for authorization to store private JSON files in Drive. */
function setupJournals(){const lock=LockService.getScriptLock();lock.waitLock(20000);try{if(!props_().getProperty('LANE_JSON_FOLDER')){const folder=DriveApp.createFolder('LANE — jurnale private');props_().setProperty('LANE_JSON_FOLDER',folder.getId())}return 'Stocarea JSON este activată. Fișierele rămân private.'}finally{lock.releaseLock()}}
