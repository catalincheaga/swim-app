    for(let i=0;i<s.clubs.length;i++)for(let j=i+1;j<s.clubs.length;j++){const a=s.clubs[i],b=s.clubs[j];if((a.startDate||'0000')<=(b.endDate||'9999')&&(b.startDate||'0000')<=(a.endDate||'9999'))fail('Perioadele cluburilor se suprapun.');}
    s.currentClub=s.currentClub||s.clubs.find(c=>!c.endDate)?.id||s.clubs.at(-1).id;if(!clubIds.has(s.currentClub))fail('Clubul actual nu există în configs.');
    s.meets=s.meets||[];if(!Array.isArray(s.meets)||s.meets.length>5000)fail('Lista concursurilor este invalidă.');const meetIds=new Set(),meetKeys=new Set();
    function addMeet(m){if(!m||typeof m.id!=='string'||!m.id||m.id.length>100||meetIds.has(m.id))fail('ID de concurs invalid sau duplicat.');const meet={id:m.id,name:text(m.name,100,'Nume concurs'),date:m.date,city:text(m.city||'',80,'Localitate',true),pool:Number(m.pool)};if(!validDate(meet.date)||![25,50].includes(meet.pool))fail('Data sau bazinul concursului este invalid.');if(meetKeys.has(key(meet)))fail('Același concurs este definit de două ori.');meetKeys.add(key(meet));meetIds.add(meet.id);return meet}
    s.meets=s.meets.map(addMeet);const ids=new Set();s.results=s.results.map((r,index)=>{
      if(!r||typeof r.id!=='string'||!r.id||r.id.length>100||ids.has(r.id))fail('ID de rezultat invalid sau duplicat.');ids.add(r.id);
      if(r.team&&r.team!=='auto'&&!clubIds.has(r.team))fail('Echipa rezultatului nu există în configs.');
      if(!validDate(r.date)||!['Liber','Spate','Bras','Fluture','Mixt','Cu placa','Ștafetă liber','Ștafetă mixt'].includes(r.stroke)||![50,100,200,400,800,1500].includes(r.distance)||![25,50].includes(r.pool)||!Number.isInteger(r.time)||r.time<=0||r.time>5999999||!(r.place===''||r.place==null||Number.isInteger(r.place)&&r.place>0&&r.place<10000||typeof r.place==='string'&&/^(Descalificat|[1-9][0-9]{0,3} \/ [1-9][0-9]{0,3})$/.test(r.place)))fail('Un rezultat are date invalide.');
      let meet;if(r.meetId){meet=s.meets.find(m=>m.id===r.meetId);if(!meet)fail('Concursul rezultatului nu există.')}else {const candidate={name:text(r.meet,100,'Nume concurs'),date:r.date,city:text(r.city||'',80,'Localitate',true)};meet=s.meets.find(m=>key(m)===key(candidate));if(!meet){meet=addMeet({id:'legacy-'+r.id,...candidate,pool:r.pool});s.meets.push(meet)}}
      const video=r.youtube||'';if(typeof video!=='string'||video.length>2000||video&&!youtubePortable(video))fail('Link YouTube invalid. Folosește https://youtube.com/watch?v=… sau https://youtu.be/…');
      return {id:r.id,meetId:meet.id,meet:meet.name,city:meet.city,date:r.date,stroke:r.stroke,distance:r.distance,pool:r.pool,time:r.time,place:r.place||'',notes:cleanImportedNotes(text(r.notes||'',500,'Notițe',true)),team:r.team||'auto',youtube:video};
    });if(s.meets.length>5000)fail('Prea multe concursuri.');return s;
  }
  function empty(){return normalize({version:2,name:'Înotător',demo:false,results:[],meets:[]})}
  function tables(input){const s=normalize(input);const configs=[CONFIG_HEADERS.slice(),['inotator','nume','','','','','',s.name],['inotator','data_nasterii','','','','','',s.swimmer.birthDate],['inotator','sex','','','','','',s.swimmer.gender],['inotator','legitimatie','','','','','',s.swimmer.registrationId],['inotator','club_actual','','','','','',s.currentClub],...s.clubs.map(c=>['club',c.id,c.name,c.short,c.color,c.startDate,c.endDate,''])];return {configs,concursuri:[MEET_HEADERS.slice(),...s.meets.map(m=>[m.id,m.name,m.date,m.city,m.pool])],date:[RESULT_HEADERS.slice(),...s.results.map(r=>[r.id,r.meetId,r.date,r.distance,r.stroke,r.pool,formatTime(r.time),r.place,r.team,r.youtube,r.notes])]}}
  function records(rows,headers,label){if(!Array.isArray(rows)||!rows.length||JSON.stringify(rows[0])!==JSON.stringify(headers))fail('Antet invalid în foaia '+label+'.');return rows.slice(1).filter(row=>row.some(v=>v!==''&&v!==null)).map(row=>Object.fromEntries(headers.map((h,i)=>[h,row[i]??''])))}
  function fromTables(t){const cfg=records(t.configs,CONFIG_HEADERS,'configs'),meets=records(t.concursuri,MEET_HEADERS,'concursuri'),races=records(t.date,RESULT_HEADERS,'date');const swimmer={},seen=new Set();cfg.forEach(r=>{const k=r.tip+'|'+r.id;if(seen.has(k))fail('ID duplicat în configs.');seen.add(k);if(r.tip==='inotator'){if(!['nume','data_nasterii','sex','legitimatie','club_actual'].includes(String(r.id)))fail('Câmp de înotător necunoscut în configs.');swimmer[r.id]=String(r.valoare);}else if(r.tip!=='club')fail('Tip necunoscut în configs.');});if(!swimmer.nume||!swimmer.nume.trim()||!swimmer.club_actual)fail('Completează numele și club_actual în configs.');const clubs=cfg.filter(r=>r.tip==='club').map(r=>({id:String(r.id),name:String(r.nume),short:String(r.prescurtare),color:String(r.culoare),startDate:String(r.de_la),endDate:String(r.pana_la)}));return normalize({version:2,demo:false,name:swimmer.nume||'Înotător',currentClub:swimmer.club_actual,transferDate:clubs.find(c=>c.id==='atack')?.startDate||DEFAULT_TRANSFER,swimmer:{birthDate:swimmer.data_nasterii||'',gender:swimmer.sex||'',registrationId:swimmer.legitimatie||''},clubs,meets:meets.map(m=>({id:String(m.id),name:String(m.concurs),date:String(m.data),city:String(m.localitate),pool:Number(m.bazin_m)})),results:races.map(r=>({id:String(r.id),meetId:String(r.concurs_id),date:String(r.data),distance:Number(r.distanta_m),stroke:String(r.procedeu),pool:Number(r.bazin_m),time:parseTime(r.timp),place:r.loc===''?'':/^\d+$/.test(String(r.loc))?Number(r.loc):String(r.loc),team:String(r.club_id)||'auto',youtube:String(r.youtube),notes:String(r.notite)}))})}
  return {CONFIG_HEADERS,MEET_HEADERS,RESULT_HEADERS,DEFAULT_TRANSFER,defaults,validDate,previousDate,parseTime,formatTime,cleanImportedNotes,youtube:youtubePortable,key,teamKey,normalize,empty,tables,fromTables};
})();
if(typeof module!=='undefined'&&module.exports)module.exports=LaneModel;
/* JSON journals. No Sheets dependency. Deploy as owner; files remain private. */
function jsonReply_(value){return ContentService.createTextOutput(JSON.stringify(value)).setMimeType(ContentService.MimeType.JSON)}
function props_(){return PropertiesService.getScriptProperties()}
function hash_(s){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(s),Utilities.Charset.UTF_8).map(b=>('0'+(b&255).toString(16)).slice(-2)).join('')}
function uuid_(s){return typeof s==='string'&&/^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$/i.test(s)}
function checkId_(id){if(!uuid_(id))throw Error('Cod UUID invalid.')}
function folder_(){const p=props_(),id=p.getProperty('LANE_JSON_FOLDER');if(!id)throw Error('Serviciul de jurnale nu este încă activat.');return DriveApp.getFolderById(id)}
function loadFile_(fileId){return JSON.parse(DriveApp.getFileById(fileId).getBlob().getDataAsString('UTF-8'))}
function saveFile_(fileId,j){DriveApp.getFileById(fileId).setContent(JSON.stringify(j))}
function journal_(id){checkId_(id);const fid=props_().getProperty('J_'+hash_(id));if(!fid)throw Error('Codul jurnalului nu este corect.');return {fid:fid,j:loadFile_(fid)}}
function snapshot_(j){return {ok:true,schema:3,revision:j.revision,slug:j.slug,aliases:j.aliases||[],data:j.data}}
function slug_(name){return name.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,'_').replace(/^_|_$/g,'')||'inotator'}
function claimRoute_(base,fid){let slug=base,n=1;while(props_().getProperty('S_'+slug)&&props_().getProperty('S_'+slug)!==fid)slug=base+'_'+(++n);props_().setProperty('S_'+slug,fid);return slug}
function ensureRoutes_(found){const j=found.j;if(j.routeVersion===1)return;const old=j.slug;j.aliases=j.aliases||[];if(old){props_().setProperty('S_'+old,found.fid);if(!j.aliases.includes(old))j.aliases.push(old)}j.slug=claimRoute_(slug_(j.data.name),found.fid);j.aliases=j.aliases.filter(x=>x!==j.slug);j.routeVersion=1;j.revision++;saveFile_(found.fid,j)}
function checkRoute_(q,j){if(q.slug&&q.slug!==j.slug&&!(j.aliases||[]).includes(q.slug))throw Error('WRONG_JOURNAL: UUID-ul nu aparține jurnalului din această adresă.')}
function limitCreate_(){const c=CacheService.getScriptCache(),key='lane_create_minute_'+Math.floor(Date.now()/60000),n=Number(c.get(key)||0);if(n>=10)throw Error('Prea multe înregistrări. Încearcă din nou peste un minut.');c.put(key,String(n+1),120)}
function createJournal_(q,migration){checkId_(q.id);checkId_(q.recovery);const p=props_(),existing=p.getProperty('J_'+hash_(q.id));if(existing){const found={fid:existing,j:loadFile_(existing)};ensureRoutes_(found);return snapshot_(found.j)}const data=LaneModel.normalize(q.data);if(data.demo)throw Error('Datele demo nu pot fi înregistrate.');if(!migration&&(data.results.length||data.meets.length))throw Error('Un jurnal nou trebuie să fie gol.');limitCreate_();const serial=Number(p.getProperty('LANE_JSON_SERIAL')||0)+1;const j={schema:3,revision:1,slug:slug_(data.name)+'_'+serial,accessHashes:[hash_(q.id)],recoveryHash:hash_(q.recovery),nameKey:data.name.trim().toLowerCase(),createdAt:new Date().toISOString(),data:data};const f=folder_().createFile('journal_'+Utilities.getUuid()+'.json',JSON.stringify(j),'application/json');p.setProperty('J_'+hash_(q.id),f.getId());p.setProperty('R_'+hash_(q.recovery),f.getId());j.slug=claimRoute_(slug_(data.name),f.getId());j.routeVersion=1;j.aliases=[];saveFile_(f.getId(),j);p.setProperty('LANE_JSON_SERIAL',String(serial));if(migration)p.setProperty('LANE_MIGRATED_JSON',f.getId());return snapshot_(j)}
function doGet(){return jsonReply_({ok:true,schema:3,service:'LANE JSON journals'})}
function doPost(e){const lock=LockService.getScriptLock();try{if(!e||!e.postData||e.postData.contents.length>2000000)throw Error('Cerere invalidă sau prea mare.');const q=JSON.parse(e.postData.contents);lock.waitLock(20000);if(q.action==='create')return jsonReply_(createJournal_(q,false));if(q.action==='migrate'){if(!q.legacyToken||hash_(q.legacyToken)!==hash_(props_().getProperty('LANE_TOKEN')||'missing'))throw Error('Migrare neautorizată.');const fid=props_().getProperty('LANE_MIGRATED_JSON');if(fid){const own=props_().getProperty('J_'+hash_(q.id));if(own===fid)return jsonReply_(snapshot_(loadFile_(fid)));throw Error('Jurnalul a fost deja migrat. Folosește UUID-ul sau codul de recuperare.')}return jsonReply_(createJournal_(q,true))}if(q.action==='recover'){checkId_(q.recovery);checkId_(q.newId);const fid=props_().getProperty('R_'+hash_(q.recovery));if(!fid)throw Error('Numele sau codul de recuperare nu este corect.');const j=loadFile_(fid);ensureRoutes_({fid:fid,j:j});checkRoute_(q,j);if(String(q.name||'').trim().toLowerCase()!==j.data.name.trim().toLowerCase())throw Error('Numele sau codul de recuperare nu este corect.');const newHash=hash_(q.newId);props_().setProperty('J_'+newHash,fid);(j.accessHashes||[]).forEach(h=>{if(h!==newHash)props_().deleteProperty('J_'+h)});j.accessHashes=[newHash];saveFile_(fid,j);return jsonReply_(snapshot_(j))}const found=journal_(q.id);ensureRoutes_(found);const j=found.j;checkRoute_(q,j);if(q.action==='read')return jsonReply_(snapshot_(j));if(q.action==='write'){if(q.revision!==j.revision)return jsonReply_({ok:false,code:'CONFLICT',error:'Jurnalul s-a schimbat pe alt dispozitiv.',current:snapshot_(j)});const next=LaneModel.normalize(q.data);if(next.demo)throw Error('Datele demo nu pot fi salvate.');j.data=next;j.revision++;j.updatedAt=new Date().toISOString();saveFile_(found.fid,j);return jsonReply_(snapshot_(j))}throw Error('Operație necunoscută.')}catch(err){return jsonReply_({ok:false,error:err.message})}finally{if(lock.hasLock())lock.releaseLock()}}
/** Run once as owner; Google asks for authorization to store private JSON files in Drive. */
function setupJournals(){const lock=LockService.getScriptLock();lock.waitLock(20000);try{if(!props_().getProperty('LANE_JSON_FOLDER')){const folder=DriveApp.createFolder('LANE — jurnale private');props_().setProperty('LANE_JSON_FOLDER',folder.getId())}return 'Stocarea JSON este activată. Fișierele rămân private.'}finally{lock.releaseLock()}}
